{
  "name": "cardiocam-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interface web do Cardiocam. Processa tudo no navegador, sem enviar imagem para servidor.",
  "scripts": {
    "test": "node testes/conferir_ids.mjs && node testes/testar.js && node testes/testar_cadencia.mjs && node testes/testar_exposicao.mjs && node testes/testar_cascata.mjs",
    "test:ids": "node testes/conferir_ids.mjs",
    "test:sinais": "node testes/testar.js",
    "test:cadencia": "node testes/testar_cadencia.mjs",
    "test:exposicao": "node testes/testar_exposicao.mjs",
    "test:cascata": "node testes/testar_cascata.mjs",
    "test:navegador": "node testes/testar_no_navegador.mjs",
    "test:navegador:real": "node testes/testar_no_navegador.mjs --real",
    "test:navegador:lenta": "node testes/testar_no_navegador.mjs --real --exposicao-maxima",
    "medir:taxas": "node testes/navegador/medir_taxas.mjs",
    "medir:exposicao": "node testes/navegador/medir_exposicao.mjs"
  }
}
